<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The LAN permissions (discovery, the control protocol, HTTP) come from :data's manifest, beside the code
         that uses them. -->

    <!-- Monitor (SPEC "Monitor mode › Service"): a foreground service of type connectedDevice, never dataSync,
         which Android 15 caps at 6 hours a day. Its prerequisite is one of the connected-device permissions:
         CHANGE_NETWORK_STATE here, and CHANGE_WIFI_MULTICAST_STATE from :data. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- The ongoing notification with its Stop action, and the optional dip notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A partial wake lock and a Wi-Fi lock for the session, so polling goes on with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Asked once, on the first Monitor start. Sightline is sideloaded, not on Play, where this is restricted. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Aim: the tick on a new peak and the double buzz on lock loss. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Aim's "use true north": one coarse fix for home, stored to 2 decimal places (SPEC Privacy). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The compass is optional: without it Aim still reads the tuner, it just can't plot. -->
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />

    <application
        android:name=".SightlineApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sightline">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares exported CSVs and reports with the app the user picks. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Not restarted by the system when killed: a half-run session is closed at the next start instead. -->
        <service
            android:name=".monitor.MonitorService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
